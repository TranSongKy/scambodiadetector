{
  "manifest_version": 3,
  "name": "Scambodia Detector",
  "description": "Kiểm tra tin nhắn, ảnh chụp màn hình và trang chat tiếng Việt có dấu hiệu lừa đảo hay không.",
  "version": "0.3.0",
  "minimum_chrome_version": "127",
  "permissions": [
    "contextMenus",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mở bảng kiểm tra tin nhắn lừa đảo"
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "options_page": "src/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
